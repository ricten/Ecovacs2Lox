#!/usr/bin/php
<?php
/**
 * Healthcheck fuer die LoxBerry-Healthcheck-Seite ("Mein LoxBerry" > "Healthcheck").
 * Aufruf: "healthcheck title" (nur die Beschreibung) oder "healthcheck check" (Pruefung, Ausgabe als JSON).
 * Statuscodes: 3 Fehler (Benachrichtigung und E-Mail), 4 Warnung, 5 OK, 6 Info.
 * Der Dienst schreibt seinen Zustand jede Sekunde nach /dev/shm/<Ordner>/status.json; hier wird nur gelesen.
 * Ein ausgeschalteter Roboter ist kein Fehler und kein Grund fuer eine Warnung.
 * Muss schnell sein und darf nichts anderes ausgeben als das JSON.
 */
$desc = 'Ecovacs2Lox: Dienst, Anmeldung bei Ecovacs und Roboter';
$arg = $argv[1] ?? '';
if ($arg === 'title') {
    echo $desc, "\n";
    exit(0);
}
if ($arg !== 'check') {
    exit(0);
}

$dev = getenv('ECO_DEV_DIR');
$run = getenv('ECO_DEV_RUN') ?: ($dev ? $dev . '/run' : '/dev/shm/REPLACELBPPLUGINDIR');
$log = $dev ? $dev . '/ecovacs.log' : 'REPLACELBPLOGDIR/ecovacs.log';

function ergebnis(string $desc, int $status, string $text, string $log): void
{
    $o = ['desc' => $desc, 'status' => $status, 'result' => trim((string)preg_replace('/\s+/', ' ', $text))];
    if (is_file($log)) {
        $o['logfile'] = $log;           // nur mit echtem Wert, sonst fuehrt der Knopf ins Leere
    }
    echo json_encode($o, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

$st = is_file("$run/status.json") ? json_decode((string)@file_get_contents("$run/status.json"), true) : null;
if (!is_array($st) || time() - (int)($st['time'] ?? 0) > 60) {
    ergebnis($desc, 3, 'Der Dienst läuft nicht (keine aktuelle Statusmeldung). Der Wächter startet ihn spätestens nach einer Minute neu; sonst im Plugin den Reiter „Test“ und die Logdatei ansehen.', $log);
}
if (empty($st['mqtt'])) {
    ergebnis($desc, 4, 'Keine Verbindung zum MQTT-Broker: ' . ($st['mqtt_error'] ?? 'unbekannt'), $log);
}
$anm = is_array($st['anmeldung'] ?? null) ? $st['anmeldung'] : [];
$as = (string)($anm['status'] ?? '');
if ($as === 'keine_daten') {
    ergebnis($desc, 6, 'Noch kein Ecovacs-Konto eingetragen (Plugin öffnen, Reiter „Konto“).', $log);
}
if ($as === 'verifizierung') {
    ergebnis($desc, 4, 'Ecovacs verlangt eine Verifizierung per E-Mail-Code (Plugin öffnen, Reiter „Konto“).', $log);
}
if ($as === 'falsch') {
    ergebnis($desc, 3, 'Anmeldung bei Ecovacs fehlgeschlagen: Konto oder Passwort sind falsch (Plugin öffnen, Reiter „Konto“).', $log);
}
if ($as === 'fehler') {
    ergebnis($desc, 4, 'Anmeldung bei Ecovacs nicht möglich: ' . ($anm['text'] ?? 'unbekannt') . ' (der Dienst versucht es weiter).', $log);
}
if ($as !== 'ok') {
    ergebnis($desc, 6, 'Anmeldung bei Ecovacs läuft.', $log);
}
$roboter = is_array($st['roboter'] ?? null) ? $st['roboter'] : [];
if (!$roboter) {
    ergebnis($desc, 6, 'Kein Roboter aktiv (Plugin öffnen, Reiter „Geräte“).', $log);
}
$fehler = [];
$aus = [];
foreach ($roboter as $name => $r) {
    if (!empty($r['aus'])) {
        $aus[] = $name;
    } elseif (empty($r['ok'])) {
        $fehler[] = $name . ' (' . ($r['error'] ?? 'Fehler') . ')';
    }
}
if ($fehler) {
    ergebnis($desc, 4, 'Roboter mit Problem: ' . implode(', ', $fehler), $log);
}
$text = count($roboter) . ' Roboter in Ordnung';
if ($aus) {
    $text .= ' (nicht erreichbar, vermutlich ausgeschaltet: ' . implode(', ', $aus) . ')';
}
ergebnis($desc, 5, $text . ', Version ' . ($st['version'] ?? '?'), $log);
